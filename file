<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Inconsistent Tech | Christmas Edition 🎁</title>
<link rel="icon" type="image/png" href="assets/images/f.png">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
@import url('https://fonts.googleapis.com/css2?family=Mountains+of+Christmas:wght@700&display=swap');

body {
  background: linear-gradient(#083109, #0a4415);
  color: #fff;
  font-family: 'Segoe UI', Arial, sans-serif;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

header {
  background: #0a4415;
  padding: 2rem 1rem;
  text-align: center;
  border-bottom: 4px solid #ff0000;
}

header img {
  width: 200px;         /* ✅ BIGGER LOGO */
  border-radius: 12px;
  display: block;
  margin: 0 auto;
}

.container {
  max-width: 1100px;
  margin: 2rem auto;
  padding: 0 1rem;
}

.updates {
  background: #154d1b;
  border-left: 6px solid #ff0000;
  padding: 1rem 1.5rem;
  margin-bottom: 2rem;
  font-size: 1.1rem;
}

.section-title {
  font-size: 1.8rem;
  margin: 2rem 0 1rem 0;
  color: #ff4444;
  font-family: 'Mountains of Christmas', cursive;
  text-shadow: 0 0 10px #ff0000;
}

.image-grid, .iframe-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.img-box, .iframe-box {
  background: #0a4415;
  border-radius: 12px;
  padding: 1rem;
  text-align: center;
}

.img-box img {
  width: 100%;
  height: 140px;
  object-fit: cover;
  border: 2px solid #ff0000;
  border-radius: 8px;
}

.iframe-box iframe {
  width: 100%;
  height: 180px;
  border: 2px solid #ff0000;
  border-radius: 8px;
  background: #000;
}

.caption {
  font-size: 1rem;
  color: #ffeeee;
}

a {
  color: #ff7777;
  font-weight: bold;
  text-decoration: none;
}
a:hover {
  text-decoration: underline;
}

/* Snowflake animation */
.snow {
  position: fixed;
  top: -50px;
  font-size: 1.8rem;
  pointer-events: none;
  animation: fall linear forwards;
}

@keyframes fall {
  0% { transform: translateY(-50px); opacity: 1; }
  100% { transform: translateY(110vh); opacity: 0; }
}
</style>
</head>

<body>

<header>
  <img src="assets/images/site.png" alt="">
</header>

<div class="container">

  <!-- Update box -->
  <div class="updates">
    <strong>Holiday Update:</strong> GO CHECK OUT https://www.youtube.com/@erthar4u
  </div>

  <!-- Images -->
  <div class="section-title">🎄 Images (festive cheer)</div>

  <div class="image-grid">
    <div class="img-box">
      <img src="" alt="Youtuber to sub to=https://www.youtube.com/@erthar4u (get a free cookie)">
      <div class="caption">free cookie!</div>
    </div>

    <div class="img-box">
      <img src="http://inconsistent.zapto.org/assets/f.png" alt="">
      <div class="caption">FAVICON</div>
    </div>

    <div class="img-box">
      <img src="download.png" alt="Wait until xmas u dumb ">
      <div class="caption">🎅 Christmas Tech Setup</div>
    </div>
  </div>

  <!-- Fixed Iframes -->
  <div class="section-title">❄️ Holiday Sites</div>

  <div class="iframe-grid">

    <div class="iframe-box">
      <iframe src="http://inconsistent.zapto.org/leaf/embed.html"></iframe>
      <div class="caption"><a href="/leaf/index.html" target="_blank">🎁 Open if you dare</a></div>
    </div>

    <!-- ✅ FIXED YouTube IFRAME (previous one was blocked / wrong) -->
    <div class="iframe-box">
      <iframe 
        src="https://www.youtube.com/embed/dQw4w9WgXcQ" 
        allow="autoplay; encrypted-media"
        allowfullscreen>
      </iframe>
      <div class="caption"><a href="https://youtube.com/@InconsistentTechBymE">🎅 Secret Video</a></div>
    </div>

    <div class="iframe-box">
      <iframe src="http://inconsistent.zapto.org/eaglercraft/"></iframe>
      <div class="caption"><a href="/eaglercraft/index.html" target="_blank">❄️ Enter the fun</a></div>
    </div>

  </div>
</div>

<script>
const flakes=["❄️","❅","❆"];
function snow(){
  const s=document.createElement("span");
  s.className="snow";
  s.textContent=flakes[Math.floor(Math.random()*flakes.length)];
  s.style.left=Math.random()*100+"vw";
  s.style.animationDuration=4+Math.random()*6+"s";
  document.body.appendChild(s);
  setTimeout(()=>s.remove(),10000);
}
setInterval(snow,1500);
</script>

</body>
</html>
